{
    "name": "componenta/skeleton",
    "description": "Componenta Framework application skeleton",
    "type": "project",
    "license": "MIT",
    "keywords": [
        "componenta",
        "framework",
        "skeleton",
        "cqrs",
        "psr-7",
        "psr-11",
        "psr-15"
    ],
    "require": {
        "componenta/app": "^6.0.0",
        "componenta/app-console": "^6.0.0",
        "componenta/app-http": "^4.0.0",
        "componenta/composer-plugin": "^2.0.0",
        "componenta/config": "^4.0.0",
        "componenta/di": "^6.0.0",
        "componenta/error-handler-app": "^2.0.0",
        "componenta/http": "^1.0",
        "componenta/http-body-parsing-middleware": "^1.2.0",
        "componenta/http-psr": "^1.2.0",
        "componenta/http-psr-nyholm": "^1.2.0",
        "componenta/interceptor": "^4.0.0",
        "componenta/path-resolver": "^1.0",
        "componenta/router": "^4.0.0",
        "componenta/router-app": "^6.0.0",
        "componenta/templater-app": "^1.3.0",
        "componenta/validation": "^3.2.0",
        "componenta/validation-app": "^4.0.0",
        "ext-ctype": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "php": "^8.5.13",
        "psr/container": "^2.0",
        "symfony/console": "^7.4 || ^8.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.1",
        "symfony/var-dumper": "^7.4 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "classmap": [
            "installer/Installer.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-root-package-install": [
            "Installer::install"
        ],
        "serve": "@php -S localhost:8000 -t public/",
        "analyse": "@php vendor/bin/phpstan analyse bin config public src tests",
        "test": "@php vendor/bin/pest"
    },
    "config": {
        "allow-plugins": {
            "componenta/composer-plugin": true,
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "extra": {
        "componenta": {
            "config-providers-file": "config/componenta-providers.php"
        },
        "branch-alias": {
            "dev-main": "5.0.x-dev",
            "dev-refactor/unified-application-build-2026-11-27": "6.0.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
